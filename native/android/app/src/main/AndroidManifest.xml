<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        L1-P1 / LSC-P1-INV-002 — family data does not leave the device.

        The three backup attributes below are a HAND EDIT of the Capacitor
        template, which ships android:allowBackup="true". Left at the default,
        Android Auto Backup would upload the app sandbox — today the WebView's
        localStorage, from L1-P2 the native store — to the user's Google Drive.
        That is family data crossing a network boundary by platform default,
        with no export contour, no key scope and no grant model behind it (all
        L7). Fail closed instead; the deliberate export contour is L1-P4.

        All three are needed, and none is redundant:
          * allowBackup="false"     — cloud backup, every API level;
          * fullBackupContent       — the API 24..30 rule format;
          * dataExtractionRules     — the API 31+ format, and the ONLY one that
                                      also covers device-to-device transfer,
                                      which allowBackup does not disable.

        The value of allowBackup is asserted by app/tests/native-shell.spec.js,
        so a Capacitor upgrade that regenerates this file reds CI rather than
        silently restoring the default.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                DIA-P1 / ADR-048 §4 — the browser-to-native history handoff.

                CUSTOM SCHEME, NOT https App Links, AND THAT IS THE DECISION
                RATHER THAN A SHORTCUT. App Links verify against a release
                signing certificate published at the origin; the Release
                workflow has never run (ADR-047), and the family's history
                exists now. A custom scheme works on the debug signature the
                device is holding today. App Links are an allowed later
                addition, not a precondition, and adding one later does not
                invalidate this filter.

                android:autoVerify is deliberately ABSENT: it is meaningful
                only for http/https and would claim a verification that
                nothing performs.

                WHAT KEEPS THE FAMILY HISTORY FROM REACHING ANOTHER APP. Not
                this filter — any app may declare the same scheme. The handoff
                page addresses the link with `package=app.theygrow` in an
                intent:// URI, so Chrome resolves it to this package or to
                nothing, with no disambiguation dialog to mis-tap. See
                TRANSFER_CONFIG.linkPackage in the mount.

                No new permission: ACTION_VIEW is delivered, not requested.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="theygrow" android:host="transfer" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
