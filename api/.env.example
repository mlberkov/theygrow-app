# theygrow-api — required environment variable NAMES (documentation only).
#
# NO real secrets here, and this file is NOT auto-loaded: Settings reads
# os.environ only (env_file is unset). Copy/adapt for local runs as needed.

# DB connection string consumed by the /api config (ADR-007 Packet-2 guard).
# Required, no default — a missing value fails loudly at Settings() construction.
# No connection is opened at M2-P2; real DB use lands in M2-P3 (Postgres 16 / pgvector).
DATABASE_URL=

# Optional, non-secret knob. Safe default is INFO when unset.
LOG_LEVEL=

# --- M4-P2 embeddings backfill (ADR-011 §1). Consumed ONLY by the offline
# `theygrow-embed` pass; the importer / derivation / sparse-leg paths ignore them.
# The embedder endpoint + key for the ZDR+DPA+EU-residency-bound provider.
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=
# Privacy clearance gate. Defaults to false (uncleared) when unset — the backfill
# refuses to send any chunk_text and writes nothing. Set to `true` ONLY once the
# ZDR + DPA + EU-residency surface is confirmed for the configured provider.
EMBEDDER_PRIVACY_CLEARED=
