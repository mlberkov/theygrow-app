      "external_chat_id": "chat-beta",
      "external_user_id": "user-beta-2",
      "external_message_id": "msg-beta-0009",
      "edit_seq": 0,
      "raw_text": "Сон днём в коляске получился длинным, разбудили только дома.\nГорло красное, врач назначил полоскание.",
      "detected_route": "note",
      "created_at": "2025-02-23T20:39:00+03:00"
