      "external_user_id": "user-beta-1",
      "external_message_id": "msg-beta-0010",
      "edit_seq": 0,
      "raw_text": "После бассейна сон глубокий, будить пришлось на ужин.\nЗа завтраком капризничал, кашу пришлось убрать.",
      "detected_route": "note",
      "created_at": "2025-03-26T20:50:00+03:00"
