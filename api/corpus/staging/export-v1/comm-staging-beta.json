      "external_user_id": "user-beta-1",
      "external_message_id": "msg-beta-0012",
      "edit_seq": 0,
      "raw_text": "2025-05-27\nСон под шум дождя получился неожиданно крепким.\nСказал целую фразу из трёх слов, я не сразу поверила.",
      "detected_route": "note",
