# Keep the /api image lean and reproducible: ship only the package + its
# build metadata. Tests, caches, and any local env files stay out of the image.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
# The synthetic staging corpus (A2-P2) is seed input for an offline CLI, never runtime
# data. Defense-in-depth only: api/Dockerfile has no wildcard COPY, so nothing outside
# pyproject.toml + theygrow_api/ reaches the image regardless of this file.
corpus/
.env
.env.*
.dockerignore
Dockerfile
